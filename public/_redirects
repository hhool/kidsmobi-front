# Pages truncates this file at ~100 lines and drops the rest without failing the
# build — we overflowed once and lost the SPA fallback (doc/redirects_en.md). So
# every line has to earn its place. Pages already resolves /x to /x.html and 308s
# /x/ to /x before reading this file, and it rejects the "200!" suffix.
# Guard: npm run check:redirects.

/probe-f/* / 200
/probe-g/* /index.html
/probe-h/* /about/ 200
/api/* https://store.balancebiketoddler.com/api/:splat 307

# Retired guide/news slugs from the import pipeline (renamed 2026-09-17).
/guides/beginner/kidspullalongwagons-b0cs2zykc4overview /guides/beginner/best-balance-bike-for-1-year-old 301
/guides/beginner/kidspullalongwagons-b0cs2zykc4image /guides/beginner/how-to-choose-the-perfect-baby-stroller 301
/news/new_product/kidspullalongwagons-b0cs2zykc4image /news/new_product/strider-bikes-kellys-juvenile-models 301

# Bare app roots have no prerendered sibling, so the shell needs an explicit
# rewrite. Their sub-paths are covered by the SPA prefix block below.
/compare /index.html 200
/auth /index.html 200
/search /index.html 200
/evaluations /index.html 200
/transparency /index.html 200
